---
/**
 * Closing band: the registration call, then the wordmark, navigation and socials.
 * Sits on the same gold bar as the navigation, bracketing the page.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { closing, REGISTER_URL, socials, tournament, tournamentNav } from '../data/tournament';

const year = new Date().getFullYear();
---
<footer class="sv-tr-footer sv-root" id="register">
  <div class="sv-container sv-tr-footer-cta">
    <p class="sv-tr-secure">{closing.title}</p>
    <Button variant="primary" arrow href={REGISTER_URL} target="_blank">{tournament.registerLabel}</Button>
  </div>

  <div class="sv-container sv-tr-footer-base">
    <a class="sv-tr-footer-logo" href="#top">
      <img src={tournament.logo} alt={tournament.name} width="157" height="45" />
    </a>

    <nav class="sv-tr-footer-nav" aria-label="Footer">
      <ul>
        {tournamentNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <ul class="sv-tr-socials">
      {socials.map((s) => (
        <li>
          {s.href
            ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <Icon name={s.icon} size={20} />
              </a>
            )
            : <span class="sv-tr-social-pending"><Icon name={s.icon} size={20} label={s.label} /></span>}
        </li>
      ))}
    </ul>

    <p class="sv-tr-copy">© {year} {tournament.name}. All rights reserved.</p>
  </div>
</footer>
