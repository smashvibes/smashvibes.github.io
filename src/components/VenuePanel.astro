---
/** Venue card: court photograph beside the address and check list, held in the grid. */
import { Image } from 'astro:assets';
import CheckList from './CheckList.astro';
import Icon from './Icon.astro';
import { venue } from '../data/site';
---
<section class="sv-venue sv-root" id="about">
  <div class="sv-container">
    <div class="sv-venue-card">
      <figure class="sv-venue-media">
        <Image
          src={venue.image}
          alt={venue.imageAlt}
          widths={[480, 720, 1034]}
          sizes="(max-width: 1080px) 100vw, 660px"
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="sv-venue-body">
        <div class="sv-venue-head">
          <span class="sv-venue-pin"><Icon name="pin" size={32} /></span>
          <div>
            <h2 class="sv-venue-name">{venue.name}</h2>
            <p class="sv-venue-address">
              {venue.building}<br />
              <a href={venue.mapUrl} target="_blank" rel="noopener noreferrer">{venue.address}</a>
            </p>
          </div>
        </div>
        <CheckList items={venue.points} />
      </div>
    </div>
  </div>
</section>
