---
/**
 * The event poster: a thumbnail that opens the full-resolution file in a new tab.
 *
 * The whole figure is the link, not just the button — on a phone the poster itself is
 * the obvious thing to tap, and a 44px button beneath it would be the only target.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { poster } from '../data/tournament';
---
<section class="sv-tr-poster sv-root" id="poster">
  <div class="sv-container sv-tr-poster-inner">
    <div class="sv-tr-poster-copy">
      <p class="sv-eyebrow">{poster.eyebrow}</p>
      <h2 class="sv-heading-title">{poster.title}</h2>
      <p class="sv-tr-poster-body">{poster.body}</p>
      <a class="sv-tr-poster-link" href={poster.file} target="_blank" rel="noopener noreferrer">
        {poster.linkLabel}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>

    <a
      class="sv-tr-poster-figure"
      href={poster.file}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${poster.linkLabel} (opens in a new tab)`}
    >
      <Image
        src={poster.image}
        alt={poster.imageAlt}
        widths={[320, 480, 640]}
        sizes="(max-width: 900px) 70vw, 360px"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</section>
