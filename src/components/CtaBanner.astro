---
/** Closing call to action on `night-900`, optionally over a photograph. */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import type { ImageMetadata } from 'astro';
import type { IconName } from './icons';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string; icon?: IconName };
  id?: string;
}

const { eyebrow, title, lede, image, primary, secondary, id } = Astro.props;
---
<section class="sv-cta sv-root sv-night" id={id}>
  {image && (
    <Image
      class="sv-cta-bg"
      src={image}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 860px) 100vw, 62vw"
      format="webp"
      quality={78}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="sv-container sv-cta-inner">
    <SectionHeading tone="night" eyebrow={eyebrow} title={title}>
      {lede}
    </SectionHeading>
    <div class="sv-cta-actions">
      {primary && <Button variant="primary" arrow href={primary.href}>{primary.label}</Button>}
      {secondary && (
        <Button variant="outline-night" icon={secondary.icon ?? 'chat'} href={secondary.href} target="_blank">
          {secondary.label}
        </Button>
      )}
    </div>
  </div>
</section>
