---
/** Closing call to action on `night-900`, optionally over a photograph. */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import type { ImageMetadata } from 'astro';
import type { IconName } from './icons';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  primary?: { label: string; href: string; icon?: IconName };
  id?: string;
}

const { eyebrow, title, lede, image, primary, id } = Astro.props;

/* Only send the reader away in a new tab when the link actually leaves the site. */
const external = primary?.href.startsWith('http') ?? false;
---
<section class="sv-cta sv-root sv-night" id={id}>
  {image && (
    <Image
      class="sv-cta-bg"
      src={image}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 860px) 100vw, 62vw"
      format="webp"
      quality={78}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="sv-container sv-cta-inner">
    <SectionHeading tone="night" eyebrow={eyebrow} title={title}>
      {lede}
    </SectionHeading>
    <div class="sv-cta-actions">
      {primary && (
        <Button variant="primary" size="lg" icon={primary.icon} arrow={!primary.icon} href={primary.href} target={external ? '_blank' : undefined}>
          {primary.label}
        </Button>
      )}
    </div>
  </div>
</section>
