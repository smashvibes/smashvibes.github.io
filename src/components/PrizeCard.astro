---
/**
 * Prize card. The total prize is the card's hero — set large in gold on a tinted panel —
 * with the first-prize split beneath (student and coach for the junior events, a single
 * line for the adults) and the runner-up pinned to the bottom so cards of different
 * lengths still line up across the row.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  total: { label: string; value: string };
  /** Heading over the split, shown only when the split has more than one line. */
  firstLabel: string;
  first: { label: string; value: string }[];
  second: { label: string; value: string };
}
const { title, total, firstLabel, first, second } = Astro.props;
const strip = (s: string) => s.replace(/:$/, '');
---
<article class="sv-prize">
  <header class="sv-prize-head">
    <span class="sv-prize-disc"><Icon name="trophy" size={26} /></span>
    <h3 class="sv-prize-title">{title}</h3>
  </header>

  <div class="sv-prize-champion">
    <p class="sv-prize-rank">{strip(total.label)}</p>
    <p class="sv-prize-amount">{total.value}</p>
  </div>

  <ul class="sv-prize-extras">
    {first.length > 1 && <li class="sv-prize-extras-head"><span>{strip(firstLabel)}</span></li>}
    {first.map((row) => (
      <li class={first.length > 1 ? 'is-split' : ''}>
        <span>{strip(row.label)}</span>
        <strong>{row.value}</strong>
      </li>
    ))}
  </ul>

  <footer class="sv-prize-runner">
    <span>{strip(second.label)}</span>
    <strong>{second.value}</strong>
  </footer>
</article>
