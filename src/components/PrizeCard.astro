---
/**
 * Prize card. The first-prize amount is the card's hero — set large in gold on a tinted
 * panel — with the supporting awards beneath and the runner-up pinned to the bottom so
 * cards of different lengths still line up across the row.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  first: { label: string; value: string }[];
  second: { label: string; value: string };
}
const { title, first, second } = Astro.props;

const [champion, ...extras] = first;
---
<article class="sv-prize">
  <header class="sv-prize-head">
    <span class="sv-prize-disc"><Icon name="trophy" size={26} /></span>
    <h3 class="sv-prize-title">{title}</h3>
  </header>

  <div class="sv-prize-champion">
    <p class="sv-prize-rank">{champion.label.replace(/:$/, '')}</p>
    <p class="sv-prize-amount">{champion.value}</p>
  </div>

  {extras.length > 0 && (
    <ul class="sv-prize-extras">
      {extras.map((row) => (
        <li>
          <span>{row.label.replace(/:$/, '')}</span>
          <strong>{row.value}</strong>
        </li>
      ))}
    </ul>
  )}

  <footer class="sv-prize-runner">
    <span>{second.label.replace(/:$/, '')}</span>
    <strong>{second.value}</strong>
  </footer>
</article>
