---
/** Category card: shuttle mark, title, subtitle, then the rule rows. */
import Icon from './Icon.astro';
import SpecRow from './SpecRow.astro';
import type { SpecRow as SpecRowData } from '../data/tournament';

interface Props {
  title: string;
  subtitle?: string;
  rows: SpecRowData[];
}
const { title, subtitle, rows } = Astro.props;
---
<article class="sv-card sv-category">
  <header class="sv-category-head">
    <Icon name="shuttlecock" size={44} class="sv-category-mark" />
    <div>
      <h3 class="sv-card-title">{title}</h3>
      {subtitle && <p class="sv-card-sub">{subtitle}</p>}
    </div>
  </header>
  <ul class="sv-spec-list">
    {rows.map((row) => <SpecRow {...row} />)}
  </ul>
</article>
