---
/** Heading row plus the 4-up photo grid. */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import { community } from '../data/site';
---
<section class="sv-community sv-root" id="community">
  <div class="sv-container">
    <div class="sv-community-head">
      <SectionHeading eyebrow={community.eyebrow} title={community.title} />
      <Button variant="outline" size="sm" arrow href={community.ctaHref} target="_blank">
        {community.ctaLabel}
      </Button>
    </div>

    <ul class="sv-photo-grid">
      {community.photos.map((photo) => (
        <li>
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[300, 450, 600]}
            sizes="(max-width: 860px) 50vw, 285px"
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
