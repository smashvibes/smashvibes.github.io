---
/**
 * One album: a masonry grid of thumbnails and a full-screen viewer.
 *
 * Every thumbnail is a plain link to its 2048 px JPEG, so without JavaScript a tap still
 * opens the photo. The script upgrades those links into a <dialog> viewer — arrows,
 * swipe, Esc to close (native to <dialog>), a download button — and mirrors the open
 * photo in the URL hash, so /tournament/gallery/winners/#img-0081 shares one frame.
 *
 * The grid is CSS columns rather than a cropped square grid: event photos mix portrait
 * and landscape, and cropping is how people get their heads cut off. The cost is that
 * order runs down each column, not across.
 */
import Icon from './Icon.astro';
import { gallery, photoSrc, thumbSrc, tournament, type GalleryAlbum } from '../data/tournament';

interface Props {
  album: GalleryAlbum;
}

const { album } = Astro.props;
const total = album.photos.length;
/** Thumbnails are rendered 640 wide; the grid reserves their height from the large size. */
const THUMB = 640;
---
<ul class="sv-gl-grid" data-gallery={album.slug}>
  {album.photos.map((p, i) => (
    <li>
      <a
        class="sv-gl-item"
        id={p.id}
        href={photoSrc(album.slug, p.id)}
        data-width={p.width}
        data-height={p.height}
      >
        <img
          src={thumbSrc(album.slug, p.id)}
          alt={`${tournament.name} 2026, ${album.title}: photo ${i + 1} of ${total}`}
          width={THUMB}
          height={Math.round((THUMB * p.height) / p.width)}
          loading={i < 6 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    </li>
  ))}
</ul>

<dialog class="sv-lb" aria-label={`${album.title} photo viewer`}>
  <div class="sv-lb-bar">
    <span class="sv-lb-count" aria-live="polite"></span>
    <a class="sv-lb-btn sv-lb-download" download>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>{gallery.downloadLabel}</span>
    </a>
    <button class="sv-lb-btn sv-lb-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
    </button>
  </div>
  <figure class="sv-lb-stage">
    <img class="sv-lb-img" alt="" />
  </figure>
  <button class="sv-lb-nav sv-lb-prev" type="button" aria-label="Previous photo">
    <Icon name="arrow-right" size={24} />
  </button>
  <button class="sv-lb-nav sv-lb-next" type="button" aria-label="Next photo">
    <Icon name="arrow-right" size={24} />
  </button>
</dialog>

<script>
  const grid = document.querySelector<HTMLElement>('.sv-gl-grid');
  const dialog = document.querySelector<HTMLDialogElement>('.sv-lb');

  if (grid && dialog) {
    const items = [...grid.querySelectorAll<HTMLAnchorElement>('.sv-gl-item')];
    const img = dialog.querySelector<HTMLImageElement>('.sv-lb-img')!;
    const count = dialog.querySelector<HTMLElement>('.sv-lb-count')!;
    const download = dialog.querySelector<HTMLAnchorElement>('.sv-lb-download')!;
    const album = grid.dataset.gallery;
    let index = -1;

    const preload = (i: number) => {
      const item = items[(i + items.length) % items.length];
      if (item) new Image().src = item.href;
    };

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      const thumb = item.querySelector('img')!;

      // The thumbnail is already in cache, so it goes up at once and the full frame
      // replaces it when it lands — no blank stage on a slow connection.
      img.src = thumb.currentSrc || thumb.src;
      img.width = Number(item.dataset.width);
      img.height = Number(item.dataset.height);
      img.alt = thumb.alt;
      img.classList.add('is-loading');
      const full = new Image();
      full.onload = () => {
        if (items[index] !== item) return;
        img.src = item.href;
        img.classList.remove('is-loading');
      };
      full.src = item.href;

      count.textContent = `${index + 1} / ${items.length}`;
      download.href = item.href;
      download.download = `starrise-cup-2026-${album}-${item.id}.jpg`;
      history.replaceState(null, '', `#${item.id}`);
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number) => {
      show(i);
      if (!dialog.open) dialog.showModal();
    };

    items.forEach((item, i) =>
      item.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(i);
      }),
    );

    dialog.querySelector('.sv-lb-prev')!.addEventListener('click', () => swiped || show(index - 1));
    dialog.querySelector('.sv-lb-next')!.addEventListener('click', () => swiped || show(index + 1));
    dialog.querySelector('.sv-lb-close')!.addEventListener('click', () => dialog.close());
    // A click on the dark surround (not the photo or a control) closes, as in every viewer.
    dialog.addEventListener('click', (e) => {
      if (swiped) return;
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('sv-lb-stage')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
      items[index]?.focus({ preventScroll: true });
      items[index]?.scrollIntoView({ block: 'nearest' });
    });

    // Horizontal swipe on touch screens (the dialog is `touch-action: pan-y pinch-zoom`,
    // so the browser hands horizontal drags to us). A mostly-vertical drag is left alone,
    // and the click a swipe can end in must not count as a tap on the surround.
    let startX = 0;
    let startY = 0;
    let swiped = false;
    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
      swiped = false;
    });
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (e.pointerType !== 'mouse' && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) {
        swiped = true;
        show(index + (dx < 0 ? 1 : -1));
      }
    });

    // A shared link to one photo opens straight onto it.
    const linked = items.findIndex((item) => `#${item.id}` === location.hash);
    if (linked >= 0) open(linked);
  }
</script>
