---
/**
 * Top navigation. The mobile menu is a checkbox-driven disclosure rather than a
 * JS toggle — it keeps the page at zero shipped JavaScript and still gives full
 * keyboard operation. The checkbox is visually hidden but focusable.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

export interface NavLink {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  logoSrc?: string;
  homeHref?: string;
  links: NavLink[];
  cta?: { label: string; href: string; icon?: IconName; target?: string };
  /** Trailing arrow instead of a leading icon — used by the tournament page. */
  ctaArrow?: boolean;
  /** Route out of a sub-site, shown first in the menu with a back arrow. */
  back?: { label: string; href: string };
}

const { logoSrc, homeHref = '/', links, cta, ctaArrow = false, back } = Astro.props;
---
<nav class="sv-nav sv-root sv-night" aria-label="Main">
  <a class="sv-nav-home" href={homeHref}>
    {logoSrc
      ? <img class="sv-nav-logo" src={logoSrc} alt="Smash Vibes" width="134" height="40" />
      : <span class="sv-eyebrow sv-nav-wordmark">Smash Vibes</span>}
  </a>

  <label class="sv-nav-burger">
    <input class="sv-nav-toggle" type="checkbox" aria-label="Menu" />
    <span aria-hidden="true"></span>
  </label>

  <ul class="sv-nav-links">
    {back && (
      <li class="sv-nav-back-item">
        <a class="sv-nav-link sv-nav-back" href={back.href}>
          <Icon name="arrow-right" size={18} class="sv-nav-back-icon" />
          {back.label}
        </a>
      </li>
    )}
    {links.map((link) => (
      <li>
        <a class="sv-nav-link" href={link.href} aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      </li>
    ))}
    {cta && (
      <li class="sv-nav-menu-cta">
        <Button variant="primary" icon={ctaArrow ? undefined : (cta.icon ?? 'chat')} arrow={ctaArrow} href={cta.href} target={cta.target}>
          {cta.label}
        </Button>
      </li>
    )}
  </ul>

  {cta && (
    <Button
      variant="primary"
      size="sm"
      icon={ctaArrow ? undefined : (cta.icon ?? 'chat')}
      arrow={ctaArrow}
      href={cta.href}
      target={cta.target}
      class="sv-nav-cta"
    >
      {cta.label}
    </Button>
  )}
</nav>
