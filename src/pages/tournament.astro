---
import { Image } from 'astro:assets';
import '../styles/tournament.css';
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import TournamentHero from '../components/TournamentHero.astro';
import TournamentFooter from '../components/TournamentFooter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PrizeCard from '../components/PrizeCard.astro';
import GuestCard from '../components/GuestCard.astro';
import SpecRow from '../components/SpecRow.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import {
  about, albumHref, backToMain, categories, cta, details, gallery, guests, highlights, prizes,
  sponsors, tournament, tournamentNav,
} from '../data/tournament';

/**
 * Event structured data. `SportsEvent` is what a search for "badminton tournament
 * Singapore November" can actually surface — date, venue, organiser and entry offer.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${tournament.name} 2026`,
  description: tournament.description,
  url: `${site.url}/tournament/`,
  sport: 'Badminton',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  startDate: '2026-11-14T10:00:00+08:00',
  endDate: '2026-11-14T17:00:00+08:00',
  image: new URL(site.ogImage, site.url).href,
  location: {
    '@type': 'Place',
    name: 'SBH VIP Hall @ Sims',
    address: {
      '@type': 'PostalAddress',
      name: 'Singapore Badminton Hall (SBH) @ Sims',
      streetAddress: '1 Lorong 23 Geylang',
      addressLocality: 'Singapore',
      postalCode: '388352',
      addressCountry: 'SG',
    },
  },
  organizer: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
  offers: {
    '@type': 'Offer',
    url: `${site.url}/tournament/`,
    availability: 'https://schema.org/InStock',
  },
};
---
<Base title={tournament.title} description={tournament.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="sv-tr-page">
  <header class="sv-header">
    <NavBar
      logoSrc={tournament.logo}
      homeHref="#top"
      links={tournamentNav.map((l) => ({ ...l, active: l.label === 'Home' }))}
      cta={cta}
      ctaArrow
      back={backToMain}
    />
  </header>

  <main id="main">
    <TournamentHero />

    <section class="sv-tr-highlights sv-root" id="highlights">
      <div class="sv-container sv-tr-highlights-inner">
        <div class="sv-tr-highlights-copy">
          <SectionHeading eyebrow={highlights.eyebrow} title={highlights.title} />
          <p class="sv-tr-highlights-body">{highlights.body}</p>
          <Button variant="primary" arrow href={cta.href}>{cta.label}</Button>
          <ul class="sv-tr-highlights-albums">
            {gallery.albums.map((album) => (
              <li>
                <a href={albumHref(album.slug)}>
                  {album.title} <span>{album.photos.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* Muted, so browsers allow it to play by itself; the script below starts it only
            while it is on screen, and never for visitors who ask for reduced motion.
            preload="none" keeps the 9 MB file off the wire until then. */}
        <video
          class="sv-tr-reel"
          src={highlights.video}
          poster={highlights.poster}
          width={highlights.width}
          height={highlights.height}
          aria-label={highlights.videoLabel}
          controls
          muted
          loop
          playsinline
          preload="none"
        ></video>
      </div>
    </section>

    <section class="sv-tr-about sv-root" id="about">
      <div class="sv-container sv-tr-about-inner">
        <SectionHeading eyebrow={about.eyebrow} title={about.title} />
        <div class="sv-tr-about-copy">
          {about.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
      <Image
        class="sv-tr-about-img"
        src={about.image}
        alt={about.imageAlt}
        widths={[480, 720, 984]}
        sizes="(max-width: 900px) 60vw, 380px"
        format="webp"
        quality={78}
        loading="lazy"
        decoding="async"
      />
    </section>

    <section class="sv-tr-categories sv-root" id="categories">
      <div class="sv-container">
        <SectionHeading eyebrow={categories.eyebrow} title={categories.title} />
        <div class="sv-tr-category-grid">
          {categories.items.map((item) => <CategoryCard {...item} />)}
        </div>
      </div>
    </section>

    <section class="sv-tr-prizes sv-root" id="prizes">
      <div class="sv-container">
        <SectionHeading eyebrow={prizes.eyebrow} title={prizes.title} />
        <div class="sv-tr-prize-grid">
          {prizes.items.map((item) => <PrizeCard {...item} />)}
        </div>
      </div>
    </section>

    <section class="sv-tr-details sv-root" id="details">
      <div class="sv-container sv-tr-details-inner">
        <div>
          <SectionHeading eyebrow={details.eyebrow} title={details.title} />
          <ul class="sv-spec-list sv-tr-details-list">
            {details.rows.map((row) => <SpecRow {...row} />)}
          </ul>
        </div>

        <figure class="sv-tr-venue">
          <Image
            src={details.venue.image}
            alt={details.venue.imageAlt}
            widths={[480, 720, 1260]}
            sizes="(max-width: 900px) 100vw, 560px"
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <Icon name="pin" size={26} />
            <span>
              <strong>{details.venue.name}</strong>
              {details.venue.lines.map((line) => <span>{line}</span>)}
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="sv-tr-sponsors sv-root" id="sponsors">
      <div class="sv-container">
        <SectionHeading eyebrow={sponsors.eyebrow} title={sponsors.title} />
        <ul class="sv-tr-sponsor-grid">
          {sponsors.items.map((s) => (
            <li>
              {!s.logo ? (
                <span class="sv-tr-sponsor-name">{s.name}</span>
              ) : s.href ? (
                <a href={s.href} target="_blank" rel="noopener sponsored" title={s.name}>
                  <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
                </a>
              ) : (
                <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sv-tr-guests sv-root" id="guests">
      <div class="sv-container">
        <SectionHeading eyebrow={guests.eyebrow} title={guests.title} />
        <div class="sv-tr-guest-grid">
          {guests.items.map((g) => <GuestCard {...g} />)}
        </div>
      </div>
    </section>
  </main>

  <TournamentFooter />
  </div>
</Base>

<script>
  const reel = document.querySelector<HTMLVideoElement>('.sv-tr-reel');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reel && !calm && 'IntersectionObserver' in window) {
    // Once someone has paused it or turned the sound on, it is theirs: stop auto-playing.
    // The pause event fires after pause() returns, so our own pauses are flagged first.
    let touched = false;
    let autoPause = false;
    reel.addEventListener('volumechange', () => { if (!reel.muted) touched = true; });
    reel.addEventListener('pause', () => {
      if (autoPause) autoPause = false;
      else if (!reel.ended) touched = true;
    });
    new IntersectionObserver(([entry]) => {
      if (touched) return;
      if (entry.isIntersecting) {
        reel.play().catch(() => {});
      } else if (!reel.paused) {
        autoPause = true;
        reel.pause();
      }
    }, { threshold: 0.5 }).observe(reel);
  }
</script>
