---
import '../../styles/tournament.css';
import Base from '../../layouts/Base.astro';
import NavBar from '../../components/NavBar.astro';
import TournamentFooter from '../../components/TournamentFooter.astro';
import DrawToolbar from '../../components/DrawToolbar.astro';
import { backToMain, draws, live, REGISTER_URL, tournament, tournamentNav } from '../../data/tournament';
import { DRAWS_FEED_URL, drawsData, eventView } from '../../data/draws';
import { formatUpdated } from '../../data/draws-engine';
import { renderLive } from '../../data/draws-render';

const title = `Live | ${tournament.name} 2026`;
const description =
  'Live scores and results for the StarRise Cup 2026 badminton tournament, published on match day, 14 November 2026.';

const DRAWS_HREF = '/tournament/draws/';

/** One board per category, from the same snapshot and feed as the draws page. */
const boards = draws.items.map((draw) => {
  const view = eventView(draw.id);
  return { ...draw, html: view ? renderLive(view, draw.label, DRAWS_HREF) : '' };
});
const updated = formatUpdated(drawsData.updatedAt);
---
<Base title={title} description={description}>
  <div class="sv-tr-page">
    <header class="sv-header sv-tr-header-solid">
      <NavBar
        logoSrc={tournament.logo}
        homeHref="/tournament/"
        links={tournamentNav.map((l) => ({ ...l, active: l.label === 'Live' }))}
        cta={{ label: tournament.registerLabel, href: REGISTER_URL, target: '_blank' }}
        ctaArrow
        back={backToMain}
      />
    </header>

    <main id="main" class="sv-dr sv-lv sv-root" data-draws-feed={DRAWS_FEED_URL}>
      <div class="sv-container">
        <h1 class="sv-dr-title">{live.title}</h1>
        <p class="sv-dr-note">{live.note}</p>
        <DrawToolbar updated={updated} />

        {boards.map((board) => (
          <div
            data-dr-view="live"
            data-dr-event={board.id}
            data-dr-label={board.label}
            data-dr-href={DRAWS_HREF}
            set:html={board.html}
          />
        ))}
      </div>
    </main>

    <TournamentFooter />
  </div>
</Base>

<script src="../../scripts/draws-live.ts"></script>
<script src="../../scripts/tv-mode.ts"></script>
